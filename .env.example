# Zugangsdaten für den Login (Pflicht)
KURS_USERNAME=paul
KURS_PASSWORD=ein-langes-geheimes-passwort

# Optional
# PORT=3000
# DATA_DIR=./data            # Ordner für kurs.db – auf dem Server ein persistentes Volume
# SESSION_SECRET=...         # sonst wird einmalig eins erzeugt und in der DB gespeichert
# PUBLIC_URL=https://kurs.deine-domain.de   # nur falls der Claude-Connector die Adresse falsch erkennt
# TZ=Europe/Berlin           # Zeitzone für „heute“
